# Template for the .env file, safe to commit because it holds no real password.
# Copy this to .env and fill in your own values:
#   copy .env.example .env
#
# The format is:
#   postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/bankingapp

# The key every access token is signed with. Anyone who has this can mint a
# token for any user, so it must never be committed and each environment
# should use its own.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_GENERATED_SECRET_HERE