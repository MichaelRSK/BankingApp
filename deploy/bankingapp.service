# Runs the FastAPI backend under uvicorn, kept alive by systemd.
#
# This is what replaces running uvicorn in a terminal. systemd starts it at
# boot, restarts it if it crashes, and keeps it running after you log out of
# SSH, which a foreground process cannot do.
#
# Install to /etc/systemd/system/bankingapp.service

[Unit]
Description=BankingApp FastAPI backend
After=network-online.target
Wants=network-online.target

# NOTE: this deliberately does NOT depend on bankingapp-env.service.
#
# That unit fetches secrets from Parameter Store, which needs an IAM role on
# the instance. The Qwiklabs account cannot create one and the instance's
# IAM role is empty, so /etc/bankingapp/env is written by hand instead. The
# file this unit reads is identical either way, so re-adding the dependency
# is all that is needed if the app ever runs somewhere with a real role:
#
#   After=network-online.target bankingapp-env.service
#   Requires=bankingapp-env.service

[Service]
Type=simple

# Not root. The app has no reason to run privileged, and if it is ever
# compromised this limits what the process can reach.
User=ec2-user
Group=ec2-user

WorkingDirectory=/home/ec2-user/BankingApp

# Written by bankingapp-env.service just above. This is what puts
# DATABASE_URL and JWT_SECRET_KEY into the process environment, which is
# where app/core/config.py and app/db/session.py already look for them.
#
# load_dotenv() in those files does not overwrite variables that already
# exist, so these win and the absent .env file is simply ignored.
EnvironmentFile=/etc/bankingapp/env

# --host 0.0.0.0 rather than 127.0.0.1. Bound to loopback the app would only
# answer requests from inside the instance, and would be unreachable from
# outside no matter how the security group is configured.
ExecStart=/home/ec2-user/BankingApp/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

# Restart on any exit, including a clean one, so a crash or an OOM kill
# brings it back rather than leaving the site down.
Restart=always
RestartSec=5

# Send stdout and stderr to the journal, so "journalctl -u bankingapp" shows
# the same output you would have seen in the terminal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
